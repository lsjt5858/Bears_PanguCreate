# Bears PanguCreate 环境配置示例
# 复制此文件为 .env 并修改配置

# ==========================================
# Flask 配置
# ==========================================
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-in-production-please-use-random-string

# ==========================================
# 数据库配置
# ==========================================
DB_TYPE=mysql

# MySQL配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=pangudata
MYSQL_PASSWORD=Lx123456
MYSQL_DATABASE=pangudata

# PostgreSQL配置（可选）
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DATABASE=pangudata

# ==========================================
# CORS 配置
# ==========================================
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# ==========================================
# JWT 配置
# ==========================================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ==========================================
# 其他配置
# ==========================================
# 日志级别
LOG_LEVEL=INFO

# 上传文件大小限制（MB）
MAX_CONTENT_LENGTH=16
