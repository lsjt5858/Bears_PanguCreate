# ========================================
# Bears_PanguCreate 后端配置文件
# ========================================

# Flask 环境配置
# 可选值: development, testing, production
FLASK_ENV=development

# 安全密钥 (生产环境必须修改为随机字符串)
SECRET_KEY=your-secret-key-change-in-production

# ========================================
# 数据库配置
# ========================================

# 数据库类型 (sqlite, mysql, postgresql)
DB_TYPE=mysql

# MySQL 配置 (当 DB_TYPE=mysql 时使用)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=pangudata

# PostgreSQL 配置 (当 DB_TYPE=postgresql 时使用)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=pangudata

# SQLite 配置 (当 DB_TYPE=sqlite 时使用)
# 数据库文件路径相对于 backend 目录
SQLITE_PATH=data/app.db

# 或者直接使用完整的数据库连接 URL (会覆盖上面的配置)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pangudata

# ========================================
# 其他配置
# ========================================

# JWT Token 过期时间 (小时)
JWT_EXPIRATION_HOURS=24

# 允许的跨域来源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
